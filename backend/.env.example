# Copy to backend/.env. Empty values fall back to the defaults in app/config.py.

# Postgres URL (Neon dev branch). Defaults to local SQLite.
DATABASE_URL=
# At least 32 characters, required on Vercel:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated. Production: https://nataliakrawczyk03.github.io
CORS_ORIGINS=
